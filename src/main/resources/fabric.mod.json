{
  "schemaVersion": 1,
  "id": "one_slot",
  "version": "${version}",
  "name": "One Slot",
  "description": "MTW에서 사용하기 위한 모드",
  "authors": [],
  "contact": {},
  "license": "GPL-3.0",
  "icon": "assets/one_slot/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.magyul.one_slot.OneSlot"
    ],
    "client": [
      "dev.magyul.one_slot.OneSlotClient"
    ],
    "modmenu": [
      "dev.magyul.one_slot.compat.modmenu.ModMenuIntegration"
    ]
  },
  "mixins": [
    "one_slot.mixins.json",
    {
      "config": "one_slot.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "cloth-config2": ">=11.1.136"
  },
  "accessWidener": "one_slot.accesswidener",
  "custom": {
    "modmenu": {
      "parent": "mtwmod"
    }
  }
}
